{
    "version": 2,
    "functions": {
        "*.php": {
            "runtime": "vercel-php@0.7.2"
        },
        "pages/*.php": {
            "runtime": "vercel-php@0.7.2"
        },
        "pages/admin/*.php": {
            "runtime": "vercel-php@0.7.2"
        }
    },
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.php"
        }
    ]
}