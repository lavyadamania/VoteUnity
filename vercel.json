{
    "builds": [
        {
            "src": "index.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "pages/**/*.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "api/*.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "css/**",
            "use": "@vercel/static"
        },
        {
            "src": "js/**",
            "use": "@vercel/static"
        },
        {
            "src": "uploads/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/css/(.*)",
            "dest": "/css/$1"
        },
        {
            "src": "/js/(.*)",
            "dest": "/js/$1"
        },
        {
            "src": "/uploads/(.*)",
            "dest": "/uploads/$1"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/index.php"
        }
    ]
}